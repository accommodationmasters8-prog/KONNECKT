# Absolute origin for canonical URLs, hreflang alternates and the sitemap.
# Without it the build falls back to an obviously-fake placeholder rather than
# publishing a wrong hostname silently. See docs/OPEN-ITEMS.md §2.2.
NEXT_PUBLIC_SITE_URL=https://konekt.crdbbank.co.tz

# --- Supabase -----------------------------------------------------------
# Without these the app still renders: every data path falls back to the
# committed CRDB register and honest empty states. See docs/DATABASE.md.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server only. Bypasses row level security entirely — for the core banking
# reconciliation feed, scheduled certificate generation and the geocoding
# pipeline. Never import the client that uses this into browser code.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Direct connection, for migrations and the seed.
DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
