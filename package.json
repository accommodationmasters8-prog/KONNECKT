{
  "name": "crdb-konekt",
  "version": "0.1.0",
  "private": true,
  "description": "CRDB Konekt — youth banking community platform, CRDB Bank Plc Tanzania.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:stats": "node scripts/verify-seed-stats.mjs",
    "check:tokens": "node scripts/check-no-raw-hex.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f supabase/tests/authorisation.sql",
    "map:build": "node scripts/geo/build-tanzania-map.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "budget": "node scripts/check-budget.mjs",
    "verify": "npm run check:tokens && npm run check:stats && npm run typecheck && npm run build && npm run budget"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.2",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "playwright-core": "^1.57.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
